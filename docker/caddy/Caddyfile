{
	admin off
	skip_install_trust
	# IP clients omit SNI; Docker forwards to a container address, not loopback.
	default_sni 127.0.0.1
	auto_https disable_redirects
	log default {
		output stderr
		format filter {
			wrap json
			fields {
				request>headers delete
				request>uri regexp \?.* ?REDACTED
				resp_headers delete
			}
		}
	}
	# Empty standalone; set to the platform subnet only when behind platform-edge.
	servers {
		trusted_proxies static {$LG_TRUSTED_PROXIES}
		trusted_proxies_strict
	}
}

(log-format) {
	format filter {
		wrap json
		fields {
			request>headers delete
			request>uri regexp \?.* ?REDACTED
			resp_headers delete
		}
	}
}

(access-log) {
	log {
		output stdout
		import log-format
	}
}

(headers-local) {
	header -Strict-Transport-Security
}

(headers-public) {
}

(headers-proxy) {
}

(status-only) {
	reverse_proxy {args[0]} {
		handle_response {
			respond "" {rp.status_code}
		}
	}
}

(health) {
	rewrite * {args[1]}
	@operator remote_ip {$LG_OPERATOR_ALLOW:127.0.0.0/8 ::1}
	handle @operator {
		reverse_proxy {args[0]}
	}
	handle {
		import status-only {args[0]}
	}
}

(app) {
	encode zstd gzip
	route {
		# Operator surfaces stay on the Docker network; never through the gateway.
		@operator path_regexp (?i)^/+metrics(/|$)
		respond @operator 404
		@public_health {
			path /health /health/* /api/public/health /api/public/ready
			not remote_ip {$LG_OPERATOR_ALLOW:127.0.0.0/8 ::1}
		}
		handle @public_health {
			import status-only {args[0]}
		}
		handle {
			reverse_proxy {args[0]}
		}
	}
}

# Stack Console and the health paths it polls. Health answers carry no secrets.
(console-health-on) {
	import health rustfs:9001 /rustfs/console/
}
(console-health-off) {
	respond 404
}
(console) {
	handle /status.json {
		route {
			request_header -Authorization
			request_header -Cookie
			header Content-Type application/json
			header Cache-Control "no-store"
			@status_method not method GET HEAD
			header @status_method Allow "GET, HEAD"
			respond @status_method "" 405
			# Bootstrap writes the Status v2 document; always send it whole, never a 304 or range.
			root * /srv/state
			request_header -If-Modified-Since
			request_header -Range
			request_header -If-Range
			request_header -If-None-Match
			header -ETag
			header -Last-Modified
			file_server {
				pass_thru
			}
			respond "" 404
		}
	}
	handle /health/rustfs-console {
		import console-health-{$LG_RUSTFS_CONSOLE:on}
	}
	# Status v2 health paths are /health/<component>; /health/langfuse predates them.
	handle /health/caddy {
		respond 200
	}
	handle /health/litellm {
		import health litellm:4000 /health/readiness
	}
	@langfuse_health path /health/langfuse /health/langfuse-web
	handle @langfuse_health {
		import health langfuse-web:3000 /api/public/health
	}
	handle /health/langfuse-worker {
		import health langfuse-worker:3030 /api/health
	}
	handle /health/clickhouse {
		import health clickhouse:8123 /ping
	}
	handle /health/rustfs {
		import health rustfs:9000 /health/live
	}
	handle /health/postgres-exporter {
		import health postgres-exporter:9187 /
	}
	handle /health/valkey-exporter {
		import health valkey-exporter:9121 /health
	}
	# Langfuse answers 503 when its PostgreSQL database is unavailable.
	handle /health/postgres {
		import health langfuse-web:3000 /api/public/health?failIfDatabaseUnavailable=true
	}
	# No HTTP probe reaches Valkey; 404 reads as unknown, never unhealthy.
	handle /health/valkey {
		respond 404
	}
	handle /health/backplane {
		import health bp-server:3000 /health/ready
	}
	handle /health/grafana {
		import health ob-grafana:3000 /api/health
	}
	@metrics path_regexp (?i)^/+metrics(/|$)
	handle @metrics {
		respond 404
	}
	handle /origins.json {
		header Cache-Control "no-store"
		header Content-Type application/json
		respond `{"scheme":"{$LG_SCHEME}","domain":"{$LG_PUBLIC_DOMAIN}","port":"{$LG_PUBLIC_PORT_SUFFIX}","console":"{$LG_CONSOLE_URL}","litellm":"{$LG_LITELLM_URL}","langfuse":"{$LG_LANGFUSE_URL}","s3":"{$LG_S3_URL}","rustfs":"{$LG_RUSTFS_URL}","rustfsConsole":"{$LG_RUSTFS_CONSOLE:on}","grafana":"{$LG_GRAFANA_URL}","backplane":"{$LG_BACKPLANE_URL}"}`
	}
	handle {
		header Cache-Control "no-cache"
		root * /srv/console
		file_server
	}
}

(litellm) {
	route {
		@ui {
			path_regexp (?i)^/+(ui.*|openapi\.json)$
			not remote_ip {$LG_OPERATOR_ALLOW:127.0.0.0/8 ::1}
		}
		respond @ui 404
		# Normalize the UI path at its configured browser origin before the app redirects.
		redir /ui {$LG_LITELLM_URL}/ui/?{query} 308
		import app litellm:4000
	}
}

(rustfs-off) {
	respond 404
}

(rustfs-on) {
	route {
		@denied not remote_ip {$LG_OPERATOR_ALLOW:127.0.0.0/8 ::1}
		respond @denied 404
		@console_landing {
			path /
			method GET HEAD
			header Accept *text/html*
		}
		redir @console_landing /rustfs/console/ 302
		import app rustfs:9001
	}
}

# Host matchers discard ports. Compare the complete authority from Edge instead.
# Each alias imports the same restrictions as its existing hostname route.
(proxy-origins) {
	@rustfs_origin expression `{http.request.hostport}.lowerAscii() == "{$LG_RUSTFS_AUTHORITY}"`
	handle @rustfs_origin {
		import rustfs-{$LG_RUSTFS_CONSOLE:on}
	}
	@console_origin expression `{http.request.hostport}.lowerAscii() == "{$LG_CONSOLE_AUTHORITY}"`
	handle @console_origin {
		import console
	}
	@litellm_origin expression `{http.request.hostport}.lowerAscii() == "{$LG_LITELLM_AUTHORITY}"`
	handle @litellm_origin {
		import litellm
	}
	@langfuse_origin expression `{http.request.hostport}.lowerAscii() == "{$LG_LANGFUSE_AUTHORITY}"`
	handle @langfuse_origin {
		import app langfuse-web:3000
	}
	@s3_origin expression `{http.request.hostport}.lowerAscii() == "{$LG_S3_AUTHORITY}"`
	handle @s3_origin {
		# Preserve Host, including the port, for S3 presigned signatures.
		reverse_proxy rustfs:9000
	}
}

(status-errors) {
	handle_errors {
		@status_error path /status.json
		handle @status_error {
			header Content-Type application/json
			header Cache-Control "no-store"
			respond "" {err.status_code}
		}
		handle {
			respond "" {err.status_code}
		}
	}
}

(gateway) {
	import status-errors
	import access-log
	import headers-{$LG_ACCESS_MODE:local}
	import host-routes
}

(host-routes) {
	@litellm host litellm.{$LG_PUBLIC_DOMAIN}
	handle @litellm {
		import litellm
	}
	@langfuse host langfuse.{$LG_PUBLIC_DOMAIN}
	handle @langfuse {
		import app langfuse-web:3000
	}
	@s3 host s3.{$LG_PUBLIC_DOMAIN}
	handle @s3 {
		reverse_proxy rustfs:9000
	}
	@rustfs host rustfs.{$LG_PUBLIC_DOMAIN}
	handle @rustfs {
		import rustfs-{$LG_RUSTFS_CONSOLE:on}
	}
	handle {
		import console
	}
}

# Issuer snippets, selected by LG_TLS_ISSUER; bootstrap validates the mode and issuer pair.
(tls-internal) {
	tls internal
}
# Empty email and dir mean Caddy's defaults (Let's Encrypt). Caddy refuses empty trusted_roots
# and eab arguments, so the overlays that supply them also select those snippets.
(tls-acme) {
	tls {
		issuer acme {
			email "{$LG_ACME_EMAIL}"
			dir "{$LG_ACME_CA}"
			import acme-trust-{$LG_ACME_TRUST:system}
			import acme-account-{$LG_ACME_ACCOUNT:none}
		}
	}
}
(acme-trust-system) {
}
(acme-trust-file) {
	trusted_roots /certs/acme-ca-root.crt
}
(acme-account-none) {
}
(acme-account-eab) {
	eab "{$LG_ACME_EAB_KEY_ID}" "{$LG_ACME_EAB_HMAC}"
}
# compose.files.yaml mounts LG_TLS_DIR read-only at /certs.
(tls-files) {
	tls /certs/tls.crt /certs/tls.key
}

(https-sites) {
	https://{$LG_PUBLIC_DOMAIN}, https://litellm.{$LG_PUBLIC_DOMAIN}, https://langfuse.{$LG_PUBLIC_DOMAIN}, https://s3.{$LG_PUBLIC_DOMAIN} {
		import tls-{$LG_TLS_ISSUER}
		import gateway
	}
	import https-rustfs-{$LG_RUSTFS_CONSOLE:on}
}

(https-rustfs-off) {
}

(https-rustfs-on) {
	https://rustfs.{$LG_PUBLIC_DOMAIN} {
		import tls-{$LG_TLS_ISSUER}
		import gateway
	}
}

(mode-local) {
	http://:80 {
		import gateway
	}
	https://127.0.0.1 {
		tls internal
		import gateway
	}
	import https-sites
}

(public-rustfs-off) {
	@rustfs host rustfs.{$LG_PUBLIC_DOMAIN}
	handle @rustfs {
		respond 404
	}
}

(public-rustfs-on) {
	@rustfs host rustfs.{$LG_PUBLIC_DOMAIN}
	handle @rustfs {
		redir https://{host}{$LG_PUBLIC_PORT_SUFFIX}{uri} 308
	}
}

(mode-public) {
	http://:80 {
		import access-log
		@health {
			host {$LG_PUBLIC_DOMAIN}
			path /health/*
		}
		handle @health {
			import console
		}
		import public-rustfs-{$LG_RUSTFS_CONSOLE:on}
		@apps host litellm.{$LG_PUBLIC_DOMAIN} langfuse.{$LG_PUBLIC_DOMAIN} s3.{$LG_PUBLIC_DOMAIN}
		handle @apps {
			redir https://{host}{$LG_PUBLIC_PORT_SUFFIX}{uri} 308
		}
		handle {
			redir https://{$LG_PUBLIC_DOMAIN}{$LG_PUBLIC_PORT_SUFFIX}{uri} 308
		}
	}
	import https-sites
}

(mode-proxy) {
	http://:80 {
		import status-errors
		import access-log
		route {
			import proxy-origins
			@configured host {$LG_PUBLIC_DOMAIN} litellm.{$LG_PUBLIC_DOMAIN} langfuse.{$LG_PUBLIC_DOMAIN} s3.{$LG_PUBLIC_DOMAIN} rustfs.{$LG_PUBLIC_DOMAIN} 127.0.0.1
			handle @configured {
				import host-routes
			}
			handle {
				respond 404
			}
		}
	}
}

import mode-{$LG_ACCESS_MODE:local}

# Unpublished listener: healthcheck via loopback, checkpoint scrape via lg-gateway:8081.
http://:8081 {
	import access-log
	handle /health/status {
		respond "ok" 200
	}
	handle /metrics {
		@denied not remote_ip {$LG_CHECKPOINT_ALLOW:127.0.0.0/8 ::1}
		respond @denied 404
		header Content-Type "text/plain; version=0.0.4"
		rewrite * /metrics.txt
		root * /srv/state
		file_server
	}
	respond 404
}
