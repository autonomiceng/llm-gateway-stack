# Public domain. Subdomains are fixed: litellm., langfuse., s3. Optional console: rustfs. Default: *.localhost.
LG_PUBLIC_DOMAIN=localhost
# http for Local Mode. https for Public Mode; Caddy then obtains certificates.
LG_SCHEME=http
# none for http. acme (public DNS) or internal (private CA) for https.
LG_TLS_ISSUER=none
# Scheme this stack's Caddy listens on. Only differs from LG_SCHEME behind platform-edge (http).
LG_LISTEN_SCHEME=
# Trusted reverse proxy CIDRs, space-separated; empty standalone, platform subnet behind the edge.
LG_TRUSTED_PROXIES=
# Socket peer CIDRs allowed operator access; include only deliberate operator sources.
LG_OPERATOR_ALLOW="127.0.0.0/8 ::1"
# Socket peer CIDRs allowed checkpoint metrics on unpublished port 8081; add the scraper address or network.
LG_CHECKPOINT_ALLOW="127.0.0.0/8 ::1"
# RustFS admin console: off by default; on enables the operator-restricted hostname.
LG_RUSTFS_CONSOLE=off
# Interface Caddy publishes on. 0.0.0.0 exposes the stack to the network.
LG_BIND_HOST=127.0.0.1
# Published HTTP port. Change if another service owns port 80.
LG_HTTP_PORT=80
# Published HTTPS port. Change if another service owns port 443.
LG_HTTPS_PORT=443
# Port part of public URLs: empty for 80/443, otherwise for example :8080.
LG_PUBLIC_PORT_SUFFIX=
# Docker network shared with the other stacks on this host.
LG_PLATFORM_NETWORK=platform
# Durable external volume prefix. Use a unique prefix for every installation.
LG_VOLUME_PREFIX=llm-gateway-stack
# Successful Checkpoints to retain; WAL before the oldest retained base backup is pruned.
LG_BACKUP_KEEP=7
# Container memory ceiling for Valkey, including AOF rewrite and allocator overhead.
LG_VALKEY_MEM_LIMIT=2g
# Host directory for the Postgres cluster. Chosen on purpose; move it to your data disk.
LG_POSTGRES_DATA_DIR=./data/postgres
# Required mounted backup repository on a different filesystem from LG_POSTGRES_DATA_DIR.
LG_BACKUP_DIR=
# Memory bound for the queue. noeviction rejects writes above it instead of dropping data.
LG_VALKEY_MAXMEMORY=1gb
# First Langfuse login. The password is generated by scripts/bootstrap.py.
LANGFUSE_INIT_USER_EMAIL=
# OpenAI API key. Empty keeps the built-in mock model working.
OPENAI_API_KEY=
# Anthropic API key for configured Claude models.
ANTHROPIC_API_KEY=
# Google Gemini API key for configured Gemini models.
GEMINI_API_KEY=
# Azure OpenAI API key for configured Azure models.
AZURE_API_KEY=
# Azure OpenAI endpoint URL for configured Azure models.
AZURE_API_BASE=
# Azure OpenAI API version for configured Azure models.
AZURE_API_VERSION=
