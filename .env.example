# Default public domain. Application subdomains: litellm., langfuse., s3. Optional console: rustfs. Default: *.localhost.
LG_PUBLIC_DOMAIN=localhost
# Access mode: local (HTTP and self-signed HTTPS), public (trusted HTTPS for your domain), proxy (another gateway handles HTTPS).
LG_ACCESS_MODE=local
# Select the matching port and origin defaults; retain this when switching modes.
COMPOSE_FILE=compose.yaml:compose.${LG_ACCESS_MODE:-local}.yaml
# Browser URL protocol; leave empty for http locally, https with public certificates or another gateway.
LG_SCHEME=
# Trusted gateway addresses, space-separated; empty standalone, preferably only Edge’s /32 or /128 address.
LG_TRUSTED_PROXIES=
# Socket peer CIDRs allowed operator access; include only deliberate operator sources.
LG_OPERATOR_ALLOW="127.0.0.0/8 ::1"
# Socket peer CIDRs allowed checkpoint metrics on unpublished port 8081; add the scraper address or network.
LG_CHECKPOINT_ALLOW="127.0.0.0/8 ::1"
# RustFS admin console: on by default; off disables the operator-restricted hostname.
LG_RUSTFS_CONSOLE=on
# Interface Caddy publishes on. 0.0.0.0 exposes the stack to the network.
LG_BIND_HOST=127.0.0.1
# Published HTTP port. Change if another service owns port 80.
LG_HTTP_PORT=80
# Published HTTPS port. Change if another service owns port 443.
LG_HTTPS_PORT=443
# Port part of public URLs: empty for 80/443, otherwise for example :8080.
LG_PUBLIC_PORT_SUFFIX=
# Full Stack Console origin; empty uses the mode, domain and port defaults.
LG_CONSOLE_URL=
# Full LiteLLM origin; empty uses the mode, domain and port defaults.
LG_LITELLM_URL=
# Full Langfuse origin; empty uses the mode, domain and port defaults.
LG_LANGFUSE_URL=
# Full S3 origin for browser media and exports; empty uses the mode, domain and port defaults.
LG_S3_URL=
# Full RustFS admin console origin; empty uses the mode, domain and port defaults.
LG_RUSTFS_URL=
# Optional Grafana browser origin for the gateway overview link.
LG_GRAFANA_URL=
# Optional Agent Backplane browser origin for the gateway overview link.
LG_BACKPLANE_URL=
# Docker network shared with the other stacks on this host.
LG_PLATFORM_NETWORK=platform
# Durable external volume prefix. Use a unique prefix for every installation.
LG_VOLUME_PREFIX=llm-gateway-stack
# Successful Checkpoints to retain; WAL before the oldest retained base backup is pruned.
LG_BACKUP_KEEP=7
# Container memory ceiling for Valkey, including AOF rewrite and allocator overhead.
LG_VALKEY_MEM_LIMIT=2g
# Host directory for the Postgres cluster. Chosen on purpose; move it to your data disk.
LG_POSTGRES_DATA_DIR=./data/postgres
# Required backup repository; production requires a separate filesystem and an off-host copy.
LG_BACKUP_DIR=
# Development only: true permits same-filesystem backups; disk loss destroys both; backup growth can fill the live data disk.
LG_ALLOW_SAME_FILESYSTEM_BACKUP=false
# Memory bound for the queue. noeviction rejects writes above it instead of dropping data.
LG_VALKEY_MAXMEMORY=1gb
# First Langfuse login. The password is generated by scripts/bootstrap.py.
LANGFUSE_INIT_USER_EMAIL=
# OpenAI API key. Empty keeps the built-in mock model working.
OPENAI_API_KEY=
# Anthropic API key for configured Claude models.
ANTHROPIC_API_KEY=
# Google Gemini API key for configured Gemini models.
GEMINI_API_KEY=
# Azure OpenAI API key for configured Azure models.
AZURE_API_KEY=
# Azure OpenAI endpoint URL for configured Azure models.
AZURE_API_BASE=
# Azure OpenAI API version for configured Azure models.
AZURE_API_VERSION=
