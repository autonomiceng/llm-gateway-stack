# Default public domain. Application subdomains: litellm., langfuse., s3., rustfs. Default: *.localhost.
LG_PUBLIC_DOMAIN=localhost
# Access mode: local (HTTP and self-signed HTTPS), public (trusted HTTPS for your domain), proxy (another gateway handles HTTPS).
LG_ACCESS_MODE=local
# Select the matching port and origin defaults; retain this when switching modes. Bootstrap adds the TLS overlays the issuer needs.
COMPOSE_FILE=compose.yaml:compose.${LG_ACCESS_MODE:-local}.yaml
# Browser URL protocol; leave empty for http locally, https with public certificates or another gateway.
LG_SCHEME=
# Trusted gateway addresses, space-separated; default is Platform Edge's reserved address on the Platform Network.
LG_TRUSTED_PROXIES=172.30.0.2/32
# Socket peer CIDRs allowed checkpoint and LiteLLM metrics on unpublished port 8081; add the scraper address or network.
LG_CHECKPOINT_ALLOW="127.0.0.0/8 ::1"
# true starts the datastore exporters; set it whenever Observability scrapes this stack, until the Platform Edge bundle sets it.
LG_METRICS=false
# Compose profiles; bootstrap adds or removes metrics to match LG_METRICS and keeps any others.
COMPOSE_PROFILES=
# Interface Caddy publishes on. 0.0.0.0 exposes the stack to the network.
LG_BIND_HOST=127.0.0.1
# Published HTTP port. Change if another service owns port 80; behind Platform Edge the contract uses 18080.
LG_HTTP_PORT=80
# Published HTTPS port. Change if another service owns port 443.
LG_HTTPS_PORT=443
# Port part of public URLs: empty for 80/443, otherwise for example :8080.
LG_PUBLIC_PORT_SUFFIX=
# Certificate issuer: empty selects internal in local mode and acme in public mode; files uses LG_TLS_DIR.
LG_TLS_ISSUER=
# Optional contact email for ACME certificate registration and renewal.
LG_ACME_EMAIL=
# ACME directory URL (https) of a private or alternative CA; empty uses Let's Encrypt.
LG_ACME_CA=
# PEM file with the private ACME server's CA, mounted for Caddy and trusted by the readiness probe.
LG_ACME_CA_ROOT=
# External account binding key identifier, when the ACME CA requires one.
LG_ACME_EAB_KEY_ID=
# External account binding HMAC key; set together with the key identifier.
LG_ACME_EAB_HMAC=
# Directory with tls.crt and tls.key for LG_TLS_ISSUER=files, mounted read-only at /certs.
LG_TLS_DIR=
# PEM file the readiness probe trusts for HTTPS when the issuing CA is not in the system store.
LG_TLS_CA=
# Full Stack Console origin; empty uses the mode, domain and port defaults.
LG_CONSOLE_URL=
# Full LiteLLM origin; empty uses the mode, domain and port defaults.
LG_LITELLM_URL=
# Full Langfuse origin; empty uses the mode, domain and port defaults.
LG_LANGFUSE_URL=
# Full S3 origin for browser media and exports; empty uses the mode, domain and port defaults.
LG_S3_URL=
# Full RustFS admin console origin; empty uses the mode, domain and port defaults.
LG_RUSTFS_URL=
# Docker network shared with the other stacks on this host.
LG_PLATFORM_NETWORK=platform
# Platform Network IPv4 subnet; every stack on this host must use the same value.
LG_PLATFORM_SUBNET=172.30.0.0/24
# Dynamic container address range inside the subnet; keep Edge's reserved address outside it.
LG_PLATFORM_IP_RANGE=172.30.0.128/25
# Durable external volume prefix. Use a unique prefix for every installation.
LG_VOLUME_PREFIX=llm-gateway-stack
# Successful Checkpoints to retain; WAL before the oldest retained base backup is pruned.
LG_BACKUP_KEEP=7
# Container memory ceiling for Valkey, including AOF rewrite and allocator overhead.
LG_VALKEY_MEM_LIMIT=2g
# Host directory for the Postgres cluster. Chosen on purpose; move it to your data disk.
LG_POSTGRES_DATA_DIR=./data/postgres
# Required backup repository; production requires a separate filesystem and an off-host copy.
LG_BACKUP_DIR=
# Development only: true permits same-filesystem backups; disk loss destroys both; backup growth can fill the live data disk.
LG_ALLOW_SAME_FILESYSTEM_BACKUP=false
# Memory bound for the queue. noeviction rejects writes above it instead of dropping data.
LG_VALKEY_MAXMEMORY=1gb
# First Langfuse login. The password is generated by scripts/bootstrap.py.
LANGFUSE_INIT_USER_EMAIL=
# OpenAI API key. Empty keeps the built-in mock model working.
OPENAI_API_KEY=
# Anthropic API key for configured Claude models.
ANTHROPIC_API_KEY=
# Google Gemini API key for configured Gemini models.
GEMINI_API_KEY=
# Azure OpenAI API key for configured Azure models.
AZURE_API_KEY=
# Azure OpenAI endpoint URL for configured Azure models.
AZURE_API_BASE=
# Azure OpenAI API version for configured Azure models.
AZURE_API_VERSION=

# Full image reference for caddy; empty uses the inline digest pin.
LG_CADDY_IMAGE=
# Full image reference for litellm; empty uses the inline digest pin.
LG_LITELLM_IMAGE=
# Full image reference for langfuse-web; empty uses the inline digest pin; keep web and worker on matching versions.
LG_LANGFUSE_WEB_IMAGE=
# Full image reference for langfuse-worker; empty uses the inline digest pin; keep web and worker on matching versions.
LG_LANGFUSE_WORKER_IMAGE=
# Full image reference for clickhouse; empty uses the inline digest pin.
LG_CLICKHOUSE_IMAGE=
# Full image reference for rustfs; empty uses the inline digest pin.
LG_RUSTFS_IMAGE=
# Full image reference for rustfs-init; empty uses the inline digest pin.
LG_AWS_CLI_IMAGE=
# Full image reference for valkey; empty uses the inline digest pin.
LG_VALKEY_IMAGE=
# Full image reference for postgres; empty uses the inline digest pin.
LG_POSTGRES_IMAGE=
# Full image reference for valkey-exporter; empty uses the inline digest pin.
LG_VALKEY_EXPORTER_IMAGE=
# Full image reference for postgres-exporter; empty uses the inline digest pin.
LG_POSTGRES_EXPORTER_IMAGE=
